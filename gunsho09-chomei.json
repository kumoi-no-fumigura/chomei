 "poems": [
  {
   "seq": "1",
   "text": "春といへはよし野の山の朝霞としをもこめてはや立にけり",
   "kana": "",
   "speaker": "鴨長明集",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "もかり舟漕出てみれはこしの海のかすみにきゆるよさの松原",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "われも今ゑのはんやとに梅植しまた見ぬ花の面かけにたつ",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "思ひやる心やかねてなかむらんまたみぬ花のおもかけにたつ",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "春くれは不破の關守いとまあれやゆきゝの人を花にまかせて",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "吉野河しからみかけて櫻さくいもせの山のあらしをそ待",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "春しあれは今年も花は咲にけり散をおしみし人はいつらは",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "よし野山高根に花や咲ぬらんはれゆく中にとまるしら雲",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "はる風に雲のしからみむらきえて高ねをあらふ花のしら浪",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "よし野河あさせしらなみ岩こえて音せぬ水はさくら成けり",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "立とまれ野への霞にことゝはむをのれはしるや春の行すゑ",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "山かつはかきほに咲るうの花の手折ほとをそおしむとはみる",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "てる月の影をかつちの枝なからおる心ちするよはの卯花",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "ほとゝきす初音聞つる名殘にはしはし物こそいはれさりけれ",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "ほとゝきす鳴一こゑやさかきとる枝にとまらぬ手向なるらん",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "五月雨の日數つもれはしら菅の葉末をうつむ井出の下水",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "芦の葉にすたく螢のほの〓〓とたとりそ渡るまのゝつき橋",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "蚊遣火の消ゆくみるそ哀なる我したもえよはてはいかにと",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "はしゐつゝ結ふ雫のさゝ浪にうつるともなき夕月夜かな",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "夏くれは過うかりけりいそのかみふるから小野のならの下陰",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "水掬ふならの木かけに風ふけはおほめく秋そふかく成ゆく",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "まてしはしまた夏山の木の下にふくへきものか秋のゆふかせ",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "花見つと人にはいはし小萩原わけつる袖の色にまかせて",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "さをしかのしからむ萩の下おれにあやなくよとむ谷川の水",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "浪まくらにしきの袖をいたしきて汀にねたる秋萩の花",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "あるしはと問ふ人あらは女郞花やとのけしきを見よと答へよ",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "わけてくる人なき庭の苅萱はをのれみたるゝ程そみえける",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "行水に雲井の雁のかけみれは數かきとむる心ちこそすれ",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "玉章のうらひきかへすこゝちして雲のあなたに名のる雁かね",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "風わたる眞葛か原のさひしきに妻こふ鹿の聲うらむなり",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "夕されは身にしむ野への秋風にたへてや鹿の聲を立らん",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "音すなり野島か崎の露のまにたかこく船のとものなるらん",
   "kana": "",
   "speaker": "鴨長明集",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "嵐ふく有明のそらに雪消て月すみのほる高まとのやま",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "月かけの雲かくれ行秋の夜はきえてつもりぬ庭のしら雪",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "なかむれはいたらぬくまもなかりけり心や月の影にそふらん",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "くまもなき鏡と見えてすむ月をもゝたひみかく沖つ白波",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "玉と見るみさきか沖の浪間より立出る月の影のさやけさ",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "契りあらは重れもやせん遙〓とうつをのみきく衣なりとも",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "月〓み磯のまつかね砧にて衣うつなりさとのあま人",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "秋山のうつれる池の水草こそ梢にみえぬ靑葉成けれ",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "くる人も枯〓なれやをみなへし秋はてゆくはをのれのみかは",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "霜にうつむ眞葛かしたのうら枯て淋しかるねのをしか鳴也",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "秋したふ虫の聲こそよはるなれとまらぬ物と誰かをしへし",
   "kana": "",
   "speaker": "",
   "page": 444,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "山のはにはなれて消ゆる薄雲はあらしのをくる時雨也けり",
   "kana": "",
   "speaker": "鴨長明集",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "音するも淋しきものと槇の板に思ひしらするはつしくれかな",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "山颪に散もみち葉やつもるらん谷のかけひの音よはる也",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "あすもこむとなせ岩なみ風ふけは花に紅葉をそへて折けり",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "冬來れは星かとみゆる花もなしみなむらさきの雲かくれつゝ",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "杉の板をかりにうちふくねやの上にたちろくはかり霰ふるん",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "霰ふる蘆のまろ屋の板ひさしね覺もよほすつまにそ有ける",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "さよ更て千とり妻とふ松かせにこぬみの濵や淋しかるらん",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "ね覺する波の枕になく千鳥をのかれにさへ袖ぬらせとや",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "薄氷つはさにかけし鳴鳥のいく夜つもりて隙もとむらん",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "水草ゐる汀をかへて鴨とりは上毛さへこそみとり成けれ",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "月影のかたふく磯にゐる千鳥かたはにのこる霜かとそみる",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "くもり行月をはしらてをく霜を拂ひえたりとをしそ鳴なる",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "片岡のならのまき葉も散はてゝ枝にとまらぬ月のしらゆふ",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "いつはりをわきて咎むるゑめのうちに晝となみえそ冬夜の月",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "霜はらふ羽音にのみそにほ鳥のあしまの床は人にしらるゝ",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "おしめとも過ゆく年のいかて又思ひかへりて身にとまるらん",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "袖にちる露うら拂ふあはれわかしらぬ戀路とふみそめてけり",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "忍ふれは音にこそたてね棹鹿の入野の露のけぬへきものを",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "まて暫しもらし初ても身の程をしるやととはゝいかゝ答へむ",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "うき身にはたえぬ思に面なれて物や思ふととふ人もなし",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "なにせむに覺束なさを歎きけん思ひたへねと書ける物を",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "越かねし逢坂山をあはれけさ歸るをとむる關守もかな",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "うちはらひ人かよひけり淺茅原ねたしや今夜露のこほれぬ",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "をのつからたかはぬ夜半の有やとてぬしなき宿に通ひ馴ぬる",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "我はたゝこむ世の闇もさもあらはあれ君たに同し道に迷はゝ",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "よそにのみならふる袖のぬるはかり淚よ床の裏つたひせよ",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "賴めつゝ妹を待まに月影をおしまて山のはにそかけたる",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "神かけて賴むれはよし心みむさてもつらくは人たのめかは",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "うつゝにはしはし袖をも引とめてさむる別をしたふかひなし",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "中にまた人をはふせし神垣やならふかひなき丸ねなりとも",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "しるしあれはいつなる物を逢とみるいもゐの床のおきうとやなそ",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "おもひ出て忍ふ淚やそひぬらん色に出なる山の井の水",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "朝露に小萩分てもならひにき雫も色もそれはものかは",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "恨みやるつらさも身にそかへりぬる君に心をかへておもへは",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "戀しさの行方もなき大空にまたみつ物はうらみ成けり",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "消かへりおさへてむせふ袖のうちに思ひ殘せる〓との葉そなき",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "する墨をもとき顔にもあらふ哉かくかひなしと泪もやしる",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "みてもいとへなにか涙をはちもせんこれそ戀てふ心うきもの",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "今よりはこりぬや心思ひしれさるそやしらぬ人にうつるは",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "忍はんと思ひしものを夕暮の風のけしきにつゐにまけぬる",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "ともかくもえこそいはねの松かけに木高く巢立鶴の子なれは",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "つの國のこやの蘆手そしとろなる難波さしたるあまの住ゐて",
   "kana": "",
   "speaker": "鴨長明集",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "かりにきてみるたにたへぬ山里にたれつれ〓〓と明暮すらん",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "奥山のまさきの葛くりかへしゆふともたえし絕ぬなけきは",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "あれはいとふ背けはしたふ數ならぬ身と心との中そゆかしき",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "心にもあらてなにそのふるかひはよし賤の身よ消はてねたゝ",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "何事をうしといふらん大方の世の習ひこそきかまほしけれ",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "うきなからすき野の雉の聲たてゝ棹とるはかり物をこそ思へ",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "霜うつむ枯野によはる虫の音のこはいつ迄か世にきこゆへき",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "世は捨つ身はなき物になしはてつなにを恨むるたか歎きそも",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "うきはいかにせんとておしむ今朝そと人にかはりて心をそとふ",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "花ゆへに通ひしものをよしの山心ほそくもおもひたつかな",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "哀ともあたにいふへき歎きかと思ふか人はしらすかほなる",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "住わびぬいさゝはこえむふての山さてたに親の跡をふむへく",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "すみ侘て急きなこえそしての山此世に親の跡をそふめ",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "情あらは我まとはすな君のみて親のあとふむ道はしるらん",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "思ひ出て忍ふもうしや古を今つかのまにわするへき身は",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "たえすちる花も有けり故〓の梅もさくらもうしや一時",
   "kana": "",
   "speaker": "",
   "page": 445,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "白雲に消ぬはかりそ夢の世をかりとなく音はをのれのみかは",
   "kana": "",
   "speaker": "鴨長明集",
   "page": 446,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "朝夕に西をそむかしと思へとも月待ほとはえこそむかはね",
   "kana": "",
   "speaker": "",
   "page": 446,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
